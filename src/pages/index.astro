---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Cover Story" description="AI-assisted resumes and cover letters.">
	<section class="stack">
		<h1>Ship a polished resume in minutes.</h1>
		<p class="muted">
			Cover Story blends structured prompts with AI drafting so you can focus on the parts that matter.
		</p>
		<div class="stack">
			<div class="card">
				<h2>What you get</h2>
				<ul>
					<li>Guided prompts for role, achievements, and tone</li>
					<li>Editable markdown preview</li>
					<li>One-click PDF export</li>
				</ul>
			</div>
		</div>
	</section>
	<section class="grid-two" style="margin-top: 24px;">
		<div class="card">
			<h3>Start generating</h3>
			<p class="muted">Jump into the generator with your latest role details.</p>
			<a class="btn" href="/generate/">Open generator</a>
		</div>
		<div class="card">
			<h3>See pricing</h3>
			<p class="muted">Preview starter and pro tiers for teams.</p>
			<a class="btn secondary" href="/pricing/">View pricing</a>
		</div>
	</section>
</MainLayout>
