---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/generate/', label: 'Generate' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/dashboard/', label: 'Dashboard' },
];
---

<header class="site-header">
  <div class="container">
    <a class="logo" href="/">Cover Story</a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
